{
  "name": "eju-study",
  "version": "3.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server.mjs",
    "build": "npm run build:content && npm run build:app",
    "build:content": "node tools/v2/build-content.mjs",
    "build:web": "npm run build:app",
    "dev": "npm run dev:app",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "validate": "node tools/v2/validate.mjs",
    "test": "node --test tests-v3/*.test.ts",
    "test:e2e": "node tools/run-v2-e2e.mjs",
    "dev:app": "vite app",
    "build:app": "vite build app"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "katex": "^0.16.47",
    "playwright": "^1.58.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
